# Browser-visible URL for the same-origin proxy. Keep this as-is on Vercel.
VITE_LUMEN_API_URL=/api/lumen

# Server-only: deployed standalone Google Apps Script web-app /exec URL.
LUMEN_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Server-only: must exactly match the LUMEN_BACKEND_SECRET Script Property.
LUMEN_BACKEND_SECRET=replace-with-a-long-random-secret
